{
  "name": "@jasonhnd/paseo-fleet-cockpit",
  "version": "0.1.0",
  "description": "Roles, quota pacing across Claude, Codex and Grok subscriptions, and a decisions inbox for a team of coding agents in Paseo.",
  "license": "MIT",
  "author": "jasonhnd",
  "homepage": "https://github.com/jasonhnd/paseo-fleet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonhnd/paseo-fleet.git"
  },
  "bugs": {
    "url": "https://github.com/jasonhnd/paseo-fleet/issues"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "agents",
    "quota",
    "dispatch",
    "kanban"
  ],
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "LICENSE",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "locales/",
    "assets/",
    "examples/",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/__fixtures__/",
    "!**/*.map",
    "bin/afc.mjs",
    "bin/roles.mjs",
    "bin/*.bundle.mjs",
    "!server/test/",
    "!server/contract/test/"
  ],
  "bin": {
    "afc": "bin/afc.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@getpaseo/protocol": "0.11.0",
    "@getpaseo/relay": "0.11.0"
  },
  "scripts": {
    "hooks": "git config core.hooksPath .githooks",
    "scan": "node scripts/check-private.mjs --all",
    "identity": "node scripts/check-identity.mjs --history",
    "pack:check": "node scripts/check-package-files.mjs",
    "prepack:check": "npm run build",
    "contract:check": "node scripts/sync-contract.mjs --check",
    "contract:manifest": "node scripts/sync-contract.mjs --write-manifest",
    "shared:check": "node scripts/compare-scripts.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test \"scripts/*.test.mjs\"",
    "test:plugin": "node scripts/test-plugin.mjs",
    "verify": "node scripts/verify.mjs",
    "build:check": "node scripts/paseo-build-check.mjs --strict",
    "build": "node bin/build-daemon-client.mjs && node bin/build-commands.mjs",
    "build:cli": "npm run build",
    "prepack": "npm run build",
    "pretest:plugin": "npm run build",
    "preverify": "npm run build",
    "compat": "npm run build:check && npm run typecheck && npm run test:plugin"
  },
  "devDependencies": {
    "@getpaseo/client": "0.11.0",
    "@getpaseo/plugin": "0.11.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "tsx": "^4.23.15",
    "react-test-renderer": "19.1.0",
    "esbuild": "^0.28.2",
    "c8": "^12.0.0",
    "jsdom": "^30.1.1",
    "react-dom": "19.1.0",
    "react-native-web": "^0.21.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
