#!/bin/sh
# paseo-fleet: refuse to push a personal identity, a tree with personal data, or a tree that fails the gates.
# Git passes one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
# Run it by hand (sh .githooks/pre-push </dev/null) to get the same checks without pushing.
set -e
cd "$(git rev-parse --show-toplevel)"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac          # deleting a remote ref: nothing leaves
  case "$remote_sha" in
    *[!0]*) range="$remote_sha..$local_sha" ;;                 # existing remote ref: the new commits
    *) range="$local_sha" ;;                                    # new remote ref: everything it carries
  esac
  node scripts/check-identity.mjs --range "$range" </dev/null || status=1
  node scripts/check-private.mjs --tree "$local_sha" </dev/null || status=1
done
# Gate 2 runs here: the whole CI set (npm run verify), whether or not GitHub Actions is on.
npm run --silent verify </dev/null || status=1
if [ "$status" -ne 0 ]; then
  echo "pre-push: refused; nothing was pushed" >&2
fi
exit "$status"
